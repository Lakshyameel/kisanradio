NODE_ENV=development
PORT=4000
DATABASE_URL=file:./dev.db
FRONTEND_URL=http://localhost:5173
# 64-byte random hex secret (generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# data.gov.in Open Government Data (OGD) API key for real-time Agmarknet mandi prices
# Register and copy your API key from: data.gov.in -> My Account -> API Keys
DATA_GOV_IN_API_KEY=

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
